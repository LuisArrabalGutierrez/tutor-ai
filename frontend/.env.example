# ====================================================================
# TUTOR IA - CONFIGURACIÓN DEL FRONTEND (Vite + React)
# Copia este archivo como .env dentro de la carpeta frontend/:
#   cp .env.example .env
# ====================================================================

# 1. URL de la API del Backend (FastAPI)
# - En desarrollo local suele ser: http://127.0.0.1:8000
# - En producción: la URL pública de tu backend desplegado
VITE_API_URL=http://127.0.0.1:8000

# 2. Credenciales públicas de Supabase para el cliente web
# Encuentra estos valores en tu panel de Supabase: Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# 3. Host / Dominio para el WebSocket de la Terminal Linux interactiva
# - En desarrollo local: puedes dejarlo vacío (se conectará por defecto a ws://localhost:8000/ws/terminal)
# - En producción con Vercel/VPS: tu dominio Ngrok o IP con WSS (ej: tu-dominio.ngrok-free.dev)
VITE_GOOGLE_IP=
