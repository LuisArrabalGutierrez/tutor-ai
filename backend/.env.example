# ====================================================================
# TUTOR IA - CONFIGURACIÓN DEL BACKEND (FastAPI + RAG + Docker)
# Copia este archivo como .env dentro de la carpeta backend/:
#   cp .env.example .env
# ====================================================================

# 1. GROQ API (Inferencia LLM de baja latencia con LLaMA / GPT-OSS)
# Obtén tu API Key gratuita en: https://console.groq.com/keys
GROQ_API_KEY=tu_groq_api_key_aqui
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# 2. GOOGLE GEMINI API (Motor principal de embeddings para el RAG y LLM de respaldo)
# Obtén tu API Key gratuita en: https://aistudio.google.com
GOOGLE_API_KEY=tu_google_api_key_aqui
GEMINI_MODEL=gemini-flash-lite-latest

# 3. SUPABASE (Base de datos PostgreSQL + pgvector + Auth)
# Crea un proyecto gratuito en https://supabase.com
# Encuentra estos valores en: Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
# IMPORTANTE: Usa la clave 'service_role' en el backend para permitir la búsqueda vectorial y gestión de perfiles
SUPABASE_KEY=tu_supabase_service_role_key_aqui

# ====================================================================
# OPCIONALES (todas tienen valor por defecto; descomenta solo para cambiarlas)
# ====================================================================
# Contenedores del servidor MCP (herramientas del tutor). Bájalo a 1 en una VM con poca RAM.
# MCP_POOL_SIZE=2
# Máximo de terminales Linux abiertas a la vez (cada una puede usar hasta 512 MB).
# MAX_TERMINALS=10
# 0 = usar el agente ReAct prefabricado en vez del grafo con guardrails (útil para comparar).
# TUTOR_GRAPH=1
# Líneas de un bloque de código a partir de las cuales el guardrail sospecha que es la solución completa.
# GUARD_MAX_CODE_LINES=12
# 0 = no arrancar el servidor MCP al iniciar la API, solo en el primer chat (lo usan los tests).
# TUTOR_MCP_EAGER=1
